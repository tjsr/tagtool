{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tagtool",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "USERID_UUID_NAMESPACE": "",
    "INTEGRATION_PROVIDERS": "[]"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // The all-zero ID is for local development only. Replace it with a separately
  // provisioned D1 ID before deploying; do not use production data in previews.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tagtool-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations-d1"
  }],
  "env": {
    "dev": {
      "name": "tagtool-dev",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "GOOGLE_CLIENT_ID": "", "USERID_UUID_NAMESPACE": "", "INTEGRATION_PROVIDERS": "[]" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "tagtool-dev",
        "database_id": "00000000-0000-0000-0000-000000000000",
        "migrations_dir": "migrations-d1"
      }]
    }
  }
}
