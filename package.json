{
  "name": "@tjsr/tagtool",
  "description": "A tool for storing tags against data elements",
  "version": "0.1.0",
  "main": "index.ts",
  "author": "Tim Rowe <tim@tjsr.id.au>",
  "license": "ISC",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf dist build",
    "clean:all": "npm run clean && npx rimraf build coverage dist node_modules",
    "test": "tsc --noEmit && node --test test/wrangler-environment.test.mjs && vitest run --config vitest.workers.config.ts && vitest run --config vitest.config.ts && npm run lint",
    "test:worker": "vitest run --config vitest.workers.config.ts",
    "check:worker": "wrangler deploy --dry-run",
    "dev:worker": "wrangler dev --local",
    "db:worker:local": "wrangler d1 migrations apply tagtool-local --local",
    "start:frontend": "cross-env GENERATE_SOURCEMAP=true PORT=3008 vite dev",
    "start:dev": "wrangler dev --local",
    "build": "vite build && tsc",
    "build:api": "npx openapi-typescript ./src/api/schema/api.yml -o ./src/api/schema/api.d.ts",
    "build:clean": "npm run clean && vite build && tsc",
    "lint": "eslint --config eslint.config.mjs src/*.ts",
    "lint:fix": "eslint --config eslint.config.mjs --fix \"./src/**/*.{ts,tsx}\"",
    "prettier": "prettier --single-quote --write \"./src/**/*.{ts,tsx}\"",
    "format": "npm run prettier && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjsr/tagtool.git"
  },
  "keywords": [
    "Tags"
  ],
  "bugs": {
    "url": "https://github.com/tjsr/tagtool/issues"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "jose": "^6.2.17",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@eslint/js": "^9.37.0",
    "@tjsr/eslint-config": "github:tjsr/eslint-config#main",
    "@types/node": "^22.17.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "minimatch": "^11.0.2",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.9.10",
    "prettier-plugin-sort-members": "^0.1.2",
    "mysql": "^2.18.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "formidable": ">=3.2.4",
    "semver": ">=7.6.0",
    "glob": "^10.4.1",
    "rimraf": "$rimraf"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.16.1",
    "npm": ">=11.4.0"
  },
  "eslintConfig": {
    "extends": [
      "@tjsr/eslint-config"
    ]
  }
}
